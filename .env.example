# Create a single-workspace access token in Attio developer settings.
# Required permissions: Objects (read), Records (read/write), Notes (read/write),
# and Users (read). Attio may label the last scope "User management".
# Never commit the real token.
ATTIO_API_URL=https://api.attio.com/v2
ATTIO_API_KEY=

# Optional. Required only when the workspace has more than one member.
ATTIO_DEAL_OWNER_EMAIL=
